# ===== Mezuka MD V5 – Configuration =====
# Copy this file to config.env and fill in your own values.
# NEVER commit config.env to GitHub.

NENO_DATA=SESSIONS
BOT_NAME=Mezuka MD V5
OWNER_NAME=Your Name
OWNER_FROM=Sri Lanka
OWNER_AGE=00
PRIFIX=.
NENO_LAN=EN
ALIVE_MSG=© Powered By Mezuka MD V5 | Black Cat Ofc

# MongoDB connection string (MongoDB Atlas or local)
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_URI=

# Optional – server port (default 8001)
PORT=8001
